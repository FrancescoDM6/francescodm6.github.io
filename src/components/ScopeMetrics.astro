---
/**
 * ScopeMetrics — Hero-style stat cards for project scope
 *
 * Displays key project metrics as a row of large-number cards.
 * Designed to sit between the outcomes block and main content
 * on case study pages.
 */

export interface Metric {
    value: string;
    label: string;
    sub?: string;
}

export interface Props {
    metrics: Metric[];
}

const { metrics } = Astro.props;
---

<div class="scope-metrics reveal">
    <h2 class="scope-heading">Project scope</h2>
    <div class="metrics-grid">
        {metrics.map((m) => (
            <div class="metric-card">
                <span class="metric-value">{m.value}</span>
                <span class="metric-label">{m.label}</span>
                {m.sub && <span class="metric-sub">{m.sub}</span>}
            </div>
        ))}
    </div>
</div>

<style>
    .scope-metrics {
        margin-bottom: 2.5rem;
    }

    .scope-heading {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        margin-bottom: 1rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: 11px;
        overflow: hidden;
    }

    .metric-card {
        background: var(--card-bg);
        padding: 1.4rem 1.2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.3rem;
    }

    .metric-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .metric-label {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--text);
        line-height: 1.3;
    }

    .metric-sub {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.68rem;
        color: var(--text-muted);
        line-height: 1.3;
    }

    @media (max-width: 640px) {
        .metrics-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
