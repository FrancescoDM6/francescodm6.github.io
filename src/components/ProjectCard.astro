---
export interface Props {
  title: string;
  subtitle: string;
  summary?: string;
  timeline: string;
  tags?: string[];
  stack?: string[];
  projectType?: string;
  slug: string;
}

const {
  title,
  subtitle,
  summary,
  timeline,
  tags = [],
  stack = [],
  projectType,
  slug,
} = Astro.props;

const chips = stack.length > 0 ? stack : tags;
---

<a href={`/projects/${slug}`} class="project-card">
  <div class="card-meta">
    {projectType && <span class="type">{projectType}</span>}
    <span class="sep">&middot;</span>
    <span>{timeline}</span>
  </div>

  <h3>{title}</h3>
  <p>{summary ?? subtitle}</p>

  {chips.length > 0 && (
    <div class="chip-row">
      {chips.slice(0, 4).map((chip) => (
        <span class="chip">{chip}</span>
      ))}
    </div>
  )}

  <span class="cta">View project <span class="arrow">&rarr;</span></span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: transform var(--duration-normal) var(--ease-out-expo), border-color var(--duration-normal) ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
  }

  .type {
    color: var(--accent);
  }

  .sep {
    color: var(--border-strong);
  }

  h3 {
    color: var(--text);
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  p {
    color: var(--text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    font-size: 0.73rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--primary);
  }

  .cta {
    margin-top: auto;
    color: var(--primary);
    font-size: 0.84rem;
    font-weight: 600;
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
  }

  .arrow {
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .project-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
