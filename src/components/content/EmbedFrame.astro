---
export interface Props {
  src: string;
  title: string;
  caption?: string;
  aspectRatio?: '16:9' | '4:3' | '1:1' | '21:9';
  allowFullScreen?: boolean;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  title,
  caption,
  aspectRatio = '16:9',
  allowFullScreen = true,
  loading = 'lazy',
} = Astro.props;

const ratioToPadding: Record<string, string> = {
  '16:9': '56.25%',
  '4:3': '75%',
  '1:1': '100%',
  '21:9': '42.857%',
};

const paddingBottom = ratioToPadding[aspectRatio] ?? ratioToPadding['16:9'];
---

<figure class="embed-frame">
  <div class="embed-shell" style={`--embed-padding:${paddingBottom};`}>
    <iframe
      src={src}
      title={title}
      loading={loading}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen={allowFullScreen}
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .embed-frame {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .embed-shell {
    position: relative;
    width: 100%;
    padding-bottom: var(--embed-padding);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: rgba(26, 58, 65, 0.55);
  }

  .embed-shell iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
</style>
