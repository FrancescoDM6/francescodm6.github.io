---
export interface Props {
  title: string;
  summary?: string;
  subtitle?: string;
  category?: string;
  readTime?: string;
  publishedLabel?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  summary,
  subtitle,
  category,
  readTime,
  publishedLabel,
  tags = [],
  slug,
} = Astro.props;
---

<a href={`/blog/${slug}`} class="blog-card">
  <div class="card-meta">
    {publishedLabel && <span>{publishedLabel}</span>}
    {readTime && (
      <>
        <span class="sep">&middot;</span>
        <span>{readTime}</span>
      </>
    )}
    {category && (
      <>
        <span class="sep">&middot;</span>
        <span class="category">{category}</span>
      </>
    )}
  </div>

  <h3>{title}</h3>
  <p>{summary ?? subtitle}</p>

  {tags.length > 0 && (
    <div class="tag-row">
      {tags.slice(0, 4).map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  <span class="cta">Read post <span class="arrow">&rarr;</span></span>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: transform var(--duration-normal) var(--ease-out-expo), border-color var(--duration-normal) ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
  }

  .sep {
    color: var(--border-strong);
  }

  .category {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  h3 {
    color: var(--text);
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  p {
    color: var(--text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.73rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--primary);
  }

  .cta {
    margin-top: auto;
    color: var(--primary);
    font-size: 0.84rem;
    font-weight: 600;
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
  }

  .arrow {
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .blog-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
