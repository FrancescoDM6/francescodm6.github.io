---
export interface Props {
    title: string;
    subtitle: string;
    company: string;
    role: string;
    timeline: string;
    tags: string[];
    outcomes?: string[];
    slug: string;
}

const { title, subtitle, company, role, timeline, tags, outcomes, slug } = Astro.props;
---

<a href={`/work/${slug}`} class="case-study-card">
    <div class="card-inner">
        <div class="card-meta">
            <span class="company">{company}</span>
            <span class="sep">&middot;</span>
            <span class="timeline">{timeline}</span>
        </div>

        <h3 class="card-title">{title}</h3>
        <p class="card-subtitle">{subtitle}</p>

        {outcomes && outcomes.length > 0 && (
            <ul class="outcomes">
                {outcomes.map((o) => (
                    <li>{o}</li>
                ))}
            </ul>
        )}

        <div class="card-footer">
            <div class="tags">
                {tags.map((tag) => (
                    <span class="tag">{tag}</span>
                ))}
            </div>
            <span class="read-cta">Read case study <span class="arrow">&rarr;</span></span>
        </div>
    </div>

    <div class="role-strip">
        <span>{role}</span>
    </div>
</a>

<style>
    .case-study-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: transform var(--duration-slow) var(--ease-out-expo),
                    border-color var(--duration-slow) ease,
                    box-shadow var(--duration-slow) ease;
    }

    .case-study-card:hover {
        transform: translateY(-5px);
        border-color: var(--primary);
        box-shadow: var(--shadow-card-hover),
                    0 0 0 1px rgba(45, 212, 190, 0.15),
                    var(--shadow-glow);
    }

    .card-inner {
        padding: 1.85rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex: 1;
    }

    .card-meta {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        color: var(--text-muted);
    }
    .sep { color: var(--border-strong); }

    .card-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text);
        line-height: 1.3;
        letter-spacing: -0.01em;
    }

    .card-subtitle {
        color: var(--text-soft);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .outcomes {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-top: 0.15rem;
    }

    .outcomes li {
        color: var(--text-soft);
        font-size: 0.84rem;
        padding-left: 1.2rem;
        position: relative;
        line-height: 1.5;
    }

    .outcomes li::before {
        content: '\2197';
        position: absolute;
        left: 0;
        color: var(--primary);
        font-size: 0.78rem;
        top: 0.1rem;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .tag {
        font-size: 0.72rem;
        font-weight: 500;
        padding: 0.2rem 0.55rem;
        background: rgba(175, 203, 207, 0.07);
        color: var(--primary);
        border: 1px solid rgba(175, 203, 207, 0.12);
        border-radius: var(--radius-sm);
    }

    .read-cta {
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        transition: color var(--duration-normal) ease;
    }

    .arrow {
        display: inline-block;
        transition: transform var(--duration-normal) var(--ease-spring);
    }

    .case-study-card:hover .arrow {
        transform: translateX(4px);
    }

    .case-study-card:hover .read-cta {
        color: var(--text);
    }

    /* Role strip */
    .role-strip {
        background: rgba(62, 66, 104, 0.2);
        border-top: 1px solid var(--border);
        padding: 0.55rem 1.6rem;
    }

    .role-strip span {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
</style>
