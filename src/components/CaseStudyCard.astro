---
export interface Props {
    title: string;
    subtitle: string;
    summary?: string;
    company: string;
    role: string;
    timeline: string;
    tags: string[];
    status?: 'draft' | 'published' | 'archived';
    locale?: string;
    outcomes?: string[];
    slug: string;
}

const {
    title,
    subtitle,
    summary,
    company,
    role,
    timeline,
    tags,
    status,
    locale,
    outcomes,
    slug,
} = Astro.props;
---

<a href={`/work/${slug}`} class="case-study-card card-container card-container--interactive">
    <div class="card-inner">
        <div class="card-meta">
            <span class="company">{company}</span>
            <span class="sep">&middot;</span>
            <span class="timeline">{timeline}</span>
            {locale && (
                <>
                    <span class="sep">&middot;</span>
                    <span class="locale">{locale}</span>
                </>
            )}
            {status && (
                <>
                    <span class="sep">&middot;</span>
                    <span class:list={[`status`, `status--${status}`]}>{status}</span>
                </>
            )}
        </div>

        <h3 class="card-title">{title}</h3>
        <p class="card-subtitle">{summary ?? subtitle}</p>

        {outcomes && outcomes.length > 0 && (
            <ul class="outcomes-list outcomes-list--compact">
                {outcomes.map((o) => (
                    <li>{o}</li>
                ))}
            </ul>
        )}

        <div class="card-footer">
            <div class="tags">
                {tags.map((tag) => (
                    <span class="tag">{tag}</span>
                ))}
            </div>
            <span class="read-cta">Read case study <span class="arrow">&rarr;</span></span>
        </div>
    </div>

    <div class="role-strip">
        <span>{role}</span>
    </div>
</a>

<style>
    .case-study-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        overflow: hidden;
    }

    .card-inner {
        padding: 1.85rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex: 1;
    }

    .card-meta {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        color: var(--text-muted);
    }
    .sep { color: var(--border-strong); }

    .status,
    .locale {
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 0.68rem;
    }

    .status {
        color: var(--accent);
    }

    .status--published { color: var(--status-green); }

    .card-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text);
        line-height: 1.3;
        letter-spacing: -0.01em;
    }

    .card-subtitle {
        color: var(--text-soft);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .outcomes-list {
        margin-top: 0.15rem;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.35rem;
    }

    .read-cta {
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        transition: color var(--duration-normal) ease;
    }

    .arrow {
        display: inline-block;
        transition: transform var(--duration-normal) var(--ease-spring);
    }

    .case-study-card:hover .arrow {
        transform: translateX(4px);
    }

    .case-study-card:hover .read-cta {
        color: var(--text);
    }

    /* Role strip */
    .role-strip {
        background: rgba(62, 66, 104, 0.2);
        border-top: 1px solid var(--border);
        padding: 0.55rem 1.6rem;
    }

    .role-strip span {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    @media (max-width: 640px) {
        .card-inner {
            padding: 1.25rem;
        }
        .role-strip {
            padding: 0.55rem 1.25rem;
        }
    }
</style>
