---
import Layout from "../../components/Layout.astro";
import { getCollection } from "astro:content";
import { site } from "../../config";
import EmbedFrame from "../../components/content/EmbedFrame.astro";
import ScreenshotFigure from "../../components/content/ScreenshotFigure.astro";
import ScreenshotGallery from "../../components/content/ScreenshotGallery.astro";
import { formatDate } from "../../utils/date";

export async function getStaticPaths() {
    const studies = await getCollection("case-studies");
    return studies
        .filter((study) => study.data.status === "published")
        .map((study) => ({
            params: { slug: study.slug },
            props: { study },
        }));
}

const { study } = Astro.props;
const { Content } = await study.render();

const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": study.data.id ?? study.slug,
    headline: study.data.title,
    description: study.data.summary ?? study.data.subtitle,
    abstract: study.data.summary ?? study.data.subtitle,
    datePublished: study.data.publishedAt?.toISOString(),
    dateModified: study.data.updatedAt?.toISOString(),
    inLanguage: study.data.locale,
    keywords: study.data.keywords ?? study.data.tags,
    url: `${site.url}/work/${study.slug}`,
    about: study.data.tags,
    author: {
        "@type": "Person",
        name: site.name,
    },
};

const publishedLabel = formatDate(study.data.publishedAt, study.data.locale);
const updatedLabel = formatDate(study.data.updatedAt, study.data.locale);
---

<Layout
    title={`${study.data.title} — ${site.name}`}
    description={study.data.summary ?? study.data.subtitle}
>
    <div class="case-study-page">
        <!-- Back nav -->
        <div class="back-row">
            <a href="/work" class="back-link">&larr; Back to Work</a>
        </div>

        <!-- Header -->
        <header class="study-header reveal">
            <div class="study-meta">
                <span class="company">{study.data.company}</span>
                <span class="dot">&middot;</span>
                <span class="timeline">{study.data.timeline}</span>
            </div>

            <h1>{study.data.title}</h1>
            <p class="study-subtitle">
                {study.data.summary ?? study.data.subtitle}
            </p>

            <div class="study-tags">
                {study.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
        </header>

        <!-- Stats row -->
        <div class="study-stats reveal">
            <div class="stat-item">
                <span class="stat-label">Role</span>
                <span class="stat-value">{study.data.role}</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Company</span>
                <span class="stat-value">{study.data.company}</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Timeline</span>
                <span class="stat-value">{study.data.timeline}</span>
            </div>
            {
                publishedLabel && (
                    <div class="stat-item">
                        <span class="stat-label">Published</span>
                        <span class="stat-value">{publishedLabel}</span>
                    </div>
                )
            }
            {
                updatedLabel && (
                    <div class="stat-item">
                        <span class="stat-label">Updated</span>
                        <span class="stat-value">{updatedLabel}</span>
                    </div>
                )
            }
            <div class="stat-item">
                <span class="stat-label">Status</span>
                <span class="stat-value">{study.data.status}</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Locale</span>
                <span class="stat-value">{study.data.locale}</span>
            </div>
        </div>

        <!-- Key outcomes -->
        {
            study.data.outcomes && study.data.outcomes.length > 0 && (
                <div class="outcomes-block reveal">
                    <h2 class="outcomes-heading">Key outcomes</h2>
                    <ul class="outcomes-list">
                        {study.data.outcomes.map((outcome) => (
                            <li>{outcome}</li>
                        ))}
                    </ul>
                </div>
            )
        }

        {
            study.data.screenshots && study.data.screenshots.length > 0 && (
                <div class="reveal">
                    <h2 class="section-title">Screenshots</h2>
                    <ScreenshotGallery items={study.data.screenshots} />
                </div>
            )
        }
        <!-- Main content -->
        <div class="study-content reveal">
            <Content
                components={{ EmbedFrame, ScreenshotFigure, ScreenshotGallery }}
            />
        </div>

        <script
            type="application/ld+json"
            set:html={JSON.stringify(articleJsonLd)}
        />

        <!-- Footer nav -->
        <div class="study-footer">
            <a href="/work" class="footer-link">&larr; Back to all work</a>
            <a href="/#contact" class="footer-cta">Get in touch &rarr;</a>
        </div>
    </div>
</Layout>

<style>
    .case-study-page {
        max-width: 740px;
        margin: 0 auto;
    }

    .back-row {
        padding: 2rem 0 1.5rem;
    }

    .back-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }
    .back-link:hover {
        color: var(--primary);
    }

    /* Header */
    .study-header {
        padding: 2.5rem 0 2rem;
        border-top: 1px solid var(--border);
    }

    .study-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
    }
    .dot {
        color: var(--border-strong);
    }

    .study-header h1 {
        font-size: clamp(1.6rem, 5vw, 2.8rem);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.025em;
        line-height: 1.12;
        margin-bottom: 1rem;
    }

    .study-subtitle {
        font-size: 1.1rem;
        color: var(--text-soft);
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .study-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 0.45rem;
    }

    .tag {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.25rem 0.65rem;
        background: rgba(175, 203, 207, 0.07);
        color: var(--primary);
        border: 1px solid rgba(175, 203, 207, 0.12);
        border-radius: 5px;
    }

    /* Stats */
    .study-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: 11px;
        overflow: hidden;
        margin-bottom: 2.5rem;
    }

    .stat-item {
        background: var(--card-bg);
        padding: 1.15rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .stat-label {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
    }

    .stat-value {
        font-size: 0.88rem;
        color: var(--text);
        font-weight: 500;
    }

    /* Outcomes */
    .outcomes-block {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 11px;
        padding: 1.6rem;
        margin-bottom: 2.5rem;
    }

    .section-title {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        margin-bottom: 0.9rem;
    }

    .outcomes-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .outcomes-list li {
        color: var(--text-soft);
        font-size: 0.92rem;
        padding-left: 1.4rem;
        position: relative;
        line-height: 1.5;
    }

    .outcomes-list li::before {
        content: "\2197";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-size: 0.82rem;
    }

    /* Content */
    .study-content {
        line-height: 1.8;
        margin-bottom: 4rem;
    }

    .study-content :global(h2) {
        font-size: 1.45rem;
        font-weight: 600;
        color: var(--text);
        letter-spacing: -0.015em;
        margin-top: 3rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
    }

    .study-content :global(h3) {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
        margin-top: 2rem;
        margin-bottom: 0.7rem;
    }

    .study-content :global(p) {
        color: var(--text-soft);
        font-size: 0.97rem;
        margin-bottom: 1.4rem;
    }

    .study-content :global(ul),
    .study-content :global(ol) {
        color: var(--text-soft);
        padding-left: 1.4rem;
        margin-bottom: 1.4rem;
    }

    .study-content :global(li) {
        margin-bottom: 0.45rem;
        font-size: 0.97rem;
    }

    .study-content :global(strong) {
        color: var(--text);
        font-weight: 600;
    }

    .study-content :global(em) {
        color: var(--primary);
        font-style: italic;
    }

    .study-content :global(blockquote) {
        border-left: 3px solid var(--accent);
        margin: 2rem 0;
        padding: 1rem 1.4rem;
        background: rgba(124, 110, 169, 0.06);
        border-radius: 0 8px 8px 0;
    }

    .study-content :global(blockquote p) {
        color: var(--text);
        font-size: 1.02rem;
        font-style: italic;
        margin-bottom: 0;
    }

    .study-content :global(code) {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.83rem;
        background: rgba(62, 66, 104, 0.25);
        color: var(--accent);
        padding: 0.18rem 0.45rem;
        border-radius: 4px;
        border: 1px solid var(--border);
    }

    .study-content :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 3rem 0;
    }

    /* Footer */
    .study-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 0;
        border-top: 1px solid var(--border);
        gap: 1rem;
        flex-wrap: wrap;
    }

    .footer-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }
    .footer-link:hover {
        color: var(--primary);
    }

    .footer-cta {
        display: inline-flex;
        align-items: center;
        padding: 0.6rem 1.15rem;
        background: var(--primary);
        color: var(--background);
        font-weight: 600;
        font-size: 0.84rem;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .footer-cta:hover {
        background: var(--text);
        transform: translateY(-1px);
    }

    @media (max-width: 640px) {
        .study-stats {
            grid-template-columns: 1fr;
        }
        .study-content :global(ul),
        .study-content :global(ol) {
            padding-left: 1.1rem;
        }
        .outcomes-block {
            padding: 1.25rem;
        }
    }
</style>
