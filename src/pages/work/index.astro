---
import Layout from '../../components/Layout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config';

const allCaseStudies = await getCollection('case-studies');
const sorted = allCaseStudies
    .filter((study) => study.data.status === 'published')
    .sort((a, b) => a.data.order - b.data.order);

const listJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sorted.map((study, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
            '@type': 'CreativeWork',
            '@id': study.data.id ?? study.slug,
            url: `${site.url}/work/${study.slug}`,
            name: study.data.title,
            abstract: study.data.summary ?? study.data.subtitle,
            inLanguage: study.data.locale,
            datePublished: study.data.publishedAt?.toISOString(),
            dateModified: study.data.updatedAt?.toISOString(),
            keywords: study.data.keywords ?? study.data.tags,
        },
    })),
};
---

<Layout title={`Work — ${site.name}`} description="Case studies in product operations, business intelligence, and AI implementation.">
    <section class="work-page">
        <header class="work-header">
            <h1>Work</h1>
            <p>Case studies — context, decisions, outcomes.</p>
        </header>

        <div class="case-studies-list">
            {sorted.map((study, i) => (
                <div class="reveal" style={`transition-delay: ${i * 0.08}s`}>
                    <CaseStudyCard
                        title={study.data.title}
                        subtitle={study.data.subtitle}
                        summary={study.data.summary}
                        company={study.data.company}
                        role={study.data.role}
                        timeline={study.data.timeline}
                        tags={study.data.tags}
                        status={study.data.status}
                        locale={study.data.locale}
                        outcomes={study.data.outcomes}
                        slug={study.slug}
                    />
                </div>
            ))}
        </div>

        <script type="application/ld+json" set:html={JSON.stringify(listJsonLd)} />
    </section>
</Layout>

<style>
    .work-page {
        padding: 2rem 0 4rem;
    }

    .work-header {
        margin-bottom: 4rem;
    }

    .work-header h1 {
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.025em;
        margin-bottom: 0.5rem;
    }

    .work-header p {
        color: var(--text-muted);
        font-size: 1rem;
    }

    .case-studies-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 1.5rem;
    }

    @media (max-width: 768px) {
        .case-studies-list {
            grid-template-columns: 1fr;
        }
    }
</style>
