---
import Layout from '../components/Layout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';
import { site, social } from '../config';

const allCaseStudies = await getCollection('case-studies');
const sorted = allCaseStudies
    .filter((study) => study.data.status === 'published')
    .sort((a, b) => a.data.order - b.data.order);

const caseStudiesJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sorted.map((study, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
            '@type': 'CreativeWork',
            '@id': study.data.id ?? study.slug,
            url: `${site.url}/work/${study.slug}`,
            name: study.data.title,
            abstract: study.data.summary ?? study.data.subtitle,
            inLanguage: study.data.locale,
            datePublished: study.data.publishedAt?.toISOString(),
            dateModified: study.data.updatedAt?.toISOString(),
            keywords: study.data.keywords ?? study.data.tags,
        },
    })),
};
---

<Layout title={`${site.name} — Product Ops & BI`}>
    <!-- ─── HERO ─── -->
    <section class="hero">
        <div class="hero-eyebrow">
            <span class="status-dot"></span>
            <span>Open to 2026 co-op / internship</span>
        </div>

        <h1 class="hero-name">{site.name}</h1>

        <div class="hero-bio">
            <p>
                MS in AI candidate at Northeastern. This past summer I implemented Salesforce Agentforce
                for a battery retailer in Latin America, designing the agent architecture and
                automation stack while keeping engineering and client stakeholders synchronized
                across languages and time zones.
            </p>
            <p>
                I'm targeting 2026 roles in <strong>Product Operations</strong> and
                <strong>Business Intelligence</strong>, where translating between
                technical details and business reality is the actual job.
            </p>
        </div>

        <div class="hero-actions">
            <a href="/work" class="btn-primary">View my work &rarr;</a>
            <a href="#contact" class="btn-secondary">Get in touch</a>
        </div>

        <div class="hero-chips">
            <span>Systems thinking</span>
            <span>Cross-functional coordination</span>
            <span>Process documentation</span>
            <span>Data analysis</span>
        </div>
    </section>

    <!-- ─── SELECTED WORK ─── -->
    <section class="work-section reveal">
        <div class="section-header">
            <div>
                <h2>Selected work</h2>
                <p class="section-sub">Case studies — context, decisions, outcomes.</p>
            </div>
            <a href="/work" class="view-all">All work &rarr;</a>
        </div>

        <div class="case-studies-grid">
            {sorted.map((study) => (
                <CaseStudyCard
                    title={study.data.title}
                    subtitle={study.data.subtitle}
                    summary={study.data.summary}
                    company={study.data.company}
                    role={study.data.role}
                    timeline={study.data.timeline}
                    tags={study.data.tags}
                    status={study.data.status}
                    locale={study.data.locale}
                    outcomes={study.data.outcomes}
                    slug={study.slug}
                />
            ))}
        </div>
    </section>

    <!-- ─── ABOUT STRIP ─── -->
    <section class="about-strip reveal">
        <div class="about-grid">
            <div class="about-block">
                <span class="about-label">Education</span>
                <p>MS Artificial Intelligence<br/>Northeastern University &middot; 2027</p>
                <p class="about-sub">BS Computer Science + BS Interactive Media & Game Design &middot; WPI</p>
            </div>
            <div class="about-block">
                <span class="about-label">Currently</span>
                <p>Building an AI assistant platform for a family distribution business across WhatsApp and phone channels.</p>
            </div>
            <div class="about-block">
                <span class="about-label">Outside work</span>
                <p>Writing <a href="https://www.royalroad.com/fiction/41035/beesekai" target="_blank" rel="noopener" class="inline-link"><em>Beesekai</em></a> — a webnovel on Royal Road with 166+ chapters over five years.</p>
            </div>
        </div>
    </section>

    <!-- ─── CONTACT ─── -->
    <section class="contact-section reveal" id="contact">
        <div class="contact-inner">
            <h2>Let's talk</h2>
            <p>
                Looking for a 2026 co-op or internship where I can bring both analytical
                rigor and cross-functional judgment. Reach out if that sounds useful.
            </p>
            <div class="contact-links">
                <a href={`mailto:${social.email}`} class="contact-link primary-link">
                    <span class="contact-icon">&#9993;</span>
                    {social.email}
                </a>
                <a href={social.linkedin} target="_blank" rel="noopener" class="contact-link">
                    <span class="contact-icon">in</span>
                    LinkedIn
                </a>
                <a href={social.github} target="_blank" rel="noopener" class="contact-link">
                    <span class="contact-icon">gh</span>
                    GitHub
                </a>
            </div>
        </div>
    </section>
    <script type="application/ld+json" set:html={JSON.stringify(caseStudiesJsonLd)} />
</Layout>

<style>
    /* ─── HERO ─── */
    .hero {
        padding: 4rem 0 5rem;
        max-width: 720px;
    }

    .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 2rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--status-green);
        box-shadow: 0 0 8px var(--status-green-glow);
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    .hero-name {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin-bottom: 2rem;
    }

    .hero-bio {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .hero-bio p {
        font-size: 1.05rem;
        color: var(--text-soft);
        line-height: 1.7;
    }

    .hero-bio strong {
        color: var(--primary);
        font-weight: 600;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 0.7rem 1.4rem;
        background: var(--primary);
        color: var(--background);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        border-radius: var(--radius-md);
        border: 1px solid var(--primary);
        transition: all var(--duration-normal) var(--ease-out-expo);
    }

    .btn-primary:hover {
        background: var(--text);
        border-color: var(--text);
        transform: translateY(-2px);
        box-shadow: var(--shadow-glow);
    }

    .btn-primary:active {
        transform: translateY(0) scale(0.97);
        box-shadow: none;
    }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        padding: 0.7rem 1.4rem;
        background: transparent;
        color: var(--text);
        font-weight: 500;
        font-size: 0.9rem;
        text-decoration: none;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-strong);
        transition: all var(--duration-normal) var(--ease-out-expo);
    }

    .btn-secondary:hover {
        background: rgba(175, 203, 207, 0.07);
        border-color: var(--primary);
        color: var(--primary);
    }

    .btn-secondary:active {
        transform: scale(0.97);
    }

    .hero-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .hero-chips span {
        font-size: 0.75rem;
        color: var(--text-muted);
        padding: 0.28rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: 100px;
        font-family: 'IBM Plex Mono', monospace;
    }

    /* ─── WORK SECTION ─── */
    .work-section {
        padding: 4rem 0;
        border-top: 1px solid var(--border);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 3rem;
    }

    .section-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.25rem;
    }

    .section-sub {
        color: var(--text-muted);
        font-size: 0.88rem;
    }

    .view-all {
        color: var(--primary);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 600;
        transition: color 0.2s ease;
        white-space: nowrap;
        margin-top: 0.25rem;
    }
    .view-all:hover { color: var(--text); }

    .case-studies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    /* ─── ABOUT STRIP ─── */
    .about-strip {
        padding: 3.5rem 0;
        border-top: 1px solid var(--border);
    }

    .about-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .about-block {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .about-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent);
        margin-bottom: 0.2rem;
    }

    .about-block p {
        color: var(--text-soft);
        font-size: 0.88rem;
        line-height: 1.55;
    }

    .about-sub {
        color: var(--text-muted) !important;
        font-size: 0.8rem !important;
        margin-top: 0.2rem;
    }

    .inline-link {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--border-strong);
        text-underline-offset: 3px;
        transition: text-decoration-color 0.2s ease;
    }
    .inline-link:hover {
        text-decoration-color: var(--primary);
    }

    .about-block em {
        color: var(--primary);
        font-style: italic;
    }

    /* ─── CONTACT ─── */
    .contact-section {
        padding: 4rem 0;
        border-top: 1px solid var(--border);
    }

    .contact-inner {
        max-width: 580px;
    }

    .contact-section h2 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
    }

    .contact-section p {
        color: var(--text-soft);
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .contact-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .contact-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.6rem 1.1rem;
        text-decoration: none;
        color: var(--text);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-md);
        font-size: 0.84rem;
        font-weight: 500;
        transition: all var(--duration-normal) var(--ease-out-expo);
    }

    .contact-link:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(175, 203, 207, 0.05);
        transform: translateY(-2px);
    }

    .contact-link.primary-link {
        background: rgba(175, 203, 207, 0.07);
        border-color: var(--primary);
        color: var(--primary);
    }

    .contact-icon {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.78rem;
        color: inherit;
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 768px) {
        .hero { padding: 3rem 0 4rem; }
        .hero-name { font-size: 2.5rem; }
        .about-grid { grid-template-columns: 1fr; gap: 1.5rem; }
        .case-studies-grid { grid-template-columns: 1fr; }
        .section-header { flex-direction: column; gap: 0.75rem; }
    }
</style>
